{
  "name": "@canopy/web",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first static web application shell (UI, persistence, 3D rendering).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@canopy/calculations": "*",
    "@canopy/geometry": "*",
    "@canopy/shared": "*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.2.1"
  }
}
